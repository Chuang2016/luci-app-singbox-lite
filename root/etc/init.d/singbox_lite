#!/bin/sh /etc/rc.common
# singbox_lite - lightweight sing-box client for iStoreOS/OpenWrt
START=99
STOP=10
USE_PROCD=1

BIN=/usr/sbin/singbox
DIR=/etc/singbox_lite
LIB=/usr/lib/singbox_lite

rand_secret() {
    head -c 12 /dev/urandom 2>/dev/null | od -A n -t x1 | tr -d ' \n'
}

start_service() {
    [ "$(uci -q get singbox_lite.main.enabled)" = "1" ] || return 1
    mkdir -p "$DIR"
    [ -x "$BIN" ] || {
        logger -t singbox_lite "sing-box binary missing at $BIN; run $LIB/install_bin.sh"
        return 1
    }
    # ensure clash api secret exists
    if [ -z "$(uci -q get singbox_lite.main.clash_secret)" ]; then
        uci set singbox_lite.main.clash_secret="$(rand_secret)"
        uci commit singbox_lite
    fi
    # default rules file
    [ -f "$DIR/rules.json" ] || cp "$LIB/rules.default.json" "$DIR/rules.json"
    # build config
    LUA_PATH="$LIB/?.lua;;" lua "$LIB/genconfig.lua" || {
        logger -t singbox_lite "genconfig failed"
        return 1
    }
    "$BIN" check -c "$DIR/config.json" >/dev/null 2>&1 || {
        logger -t singbox_lite "config check failed"
        return 1
    }
    procd_open_instance
    procd_set_param command "$BIN" run -c "$DIR/config.json"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    logger -t singbox_lite "started"
}

stop_service() {
    logger -t singbox_lite "stopped"
}

reload_service() {
    # sing-box has no config reload; restart is fast (<1s)
    stop
    start
}
